# ==============================================================================
# TiqueTaque Sync Admin — Enterprise Configuration
# ==============================================================================

# --- TiqueTaque Public Admin API (v2.1) ---
# Token gerado em: https://admin.tiquetaque.app/settings/integrations/publicapi
TIQUETAQUE_ADMIN_TOKEN=cole-aqui-o-token-uuid-da-api-publica
TIQUETAQUE_API_BASE_URL=https://api.tiquetaque.com/v2.1

# --- Slack Bot Configuration ("TiqueTaque Ponto") ---
# Bot Token do Slack App com permissões: chat:write, users:read, users:read.email, im:write
SLACK_ENABLED=true
SLACK_BOT_TOKEN=xoxb-cole-aqui-o-token-do-seu-bot
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# --- Empresa / Sincronização em Lote ---
# Intervalo em segundos entre varreduras da API do TiqueTaque (padrão: 180s = 3 min)
POLL_INTERVAL_SECONDS=180
# Ticker rápido local para avaliação precisa dos alertas (padrão: 15s)
ALERT_TICKER_INTERVAL_SECONDS=15
TIMEZONE=America/Sao_Paulo

# --- Regras Padrão da Empresa para Alertas ---
# Tempo de aviso preventivo unificado da empresa (minutos antes do almoço, saída ou limite CLT)
DEFAULT_WARNING_ADVANCE_MINUTES=10
DEFAULT_LUNCH_WARNING_FINAL_MINUTES=1
DEFAULT_END_WORK_WARNING_FINAL_MINUTES=1
# Limite da CLT (Artigo 71 - máx 6h contínuas de trabalho)
DEFAULT_CONTINUOUS_WORK_LIMIT_HOURS=6.0
DEFAULT_CONTINUOUS_WORK_WARNING_ADVANCE_MINUTES=10
DEFAULT_CONTINUOUS_WORK_WARNING_FINAL_MINUTES=1

# --- Políticas da Empresa (Governança RH) ---
# Permitir que os funcionários customizem seus tempos de alerta via Slack Bot?
ALLOW_EMPLOYEE_CUSTOMIZATION=true

# --- Servidor & Armazenamento ---
HOST=0.0.0.0
PORT=8000
DATA_DIR=data
ADMIN_SECRET_KEY=generate_a_secure_admin_key_here
